---
import type { Section } from '../config';

interface Props {
  section: Section;
  count: number;
}
const { section, count } = Astro.props;
---
<a href={`/${section.key}/`} class="card block p-5">
  <div class="flex items-center justify-between">
    <h3 class="text-lg font-semibold">{section.name}</h3>
    <span class="rounded-full px-2.5 py-0.5 text-xs font-medium" style="background: var(--color-accent-soft); color: var(--color-accent)">{count} 篇</span>
  </div>
  <p class="mt-2 text-sm" style="color: var(--color-muted)">{section.description}</p>
</a>
