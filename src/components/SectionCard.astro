---
import { SITE, type Section } from '../config';
import { svgIcon } from '../lib/icons';

interface Props {
  section: Section;
  count: number;
}
const { section, count } = Astro.props;
---
<div class="card section-card" style={`--c: ${section.color}`}>
  <div>
    <div class="section-card-head">
      <a href={`/${section.key}/`} class="section-card-title">
        <Fragment set:html={svgIcon(section.icon)} />
        <span>{section.name}</span>
      </a>
      <span class="tag">{count} 篇长文</span>
    </div>
    <p class="section-card-desc mt-2">{section.description}</p>
  </div>
  <div class="section-card-foot">
    <a href={`/${section.key}/`} style="color: var(--accent); font-weight: 600;">看专栏与动态 →</a>
    <a href={`${SITE.forumUrl}/t/${section.key}`} class="muted">💬 去本区发帖 →</a>
  </div>
</div>
