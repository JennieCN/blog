---
import { SECTIONS, SITE } from '../config';
---
<header class="border-b" style="border-color: var(--color-border)">
  <div class="container flex items-center justify-between py-4">
    <a href="/" class="font-semibold">{SITE.title}</a>
    <nav class="hidden md:flex items-center gap-6 text-sm">
      {SECTIONS.map((s) => <a href={`/${s.key}/`}>{s.name}</a>)}
      <a href="/qa/">问答</a>
      <a href="/search/">搜索</a>
      <a href="https://qa.mycampusmail.com/" class="rounded px-3 py-1 text-white" style="background: var(--color-accent)">注册 / 提问</a>
      <a href="/yjcnb/" class="admin-link hidden" style="color: var(--color-accent)">管理</a>
    </nav>
    <details class="md:hidden">
      <summary class="cursor-pointer text-sm">菜单</summary>
      <nav class="absolute right-4 mt-2 flex flex-col gap-2 rounded border bg-[var(--color-bg)] p-4 text-sm" style="border-color: var(--color-border)">
        {SECTIONS.map((s) => <a href={`/${s.key}/`}>{s.name}</a>)}
        <a href="/qa/">问答</a>
        <a href="/search/">搜索</a>
        <a href="https://qa.mycampusmail.com/" style="color: var(--color-accent)">注册 / 提问</a>
        <a href="/yjcnb/" class="admin-link hidden" style="color: var(--color-accent)">管理</a>
      </nav>
    </details>
  </div>
</header>

<script>
  // 只有登录过 CMS 后台的浏览器才显示「管理」入口，普通访客看不到
  try {
    const user = localStorage.getItem('sveltia-cms.user');
    if (user && JSON.parse(user).token) {
      document.querySelectorAll('.admin-link').forEach((el) => el.classList.remove('hidden'));
    }
  } catch {}
</script>
