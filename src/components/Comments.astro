---
import { SITE } from '../config';

interface Props {
  path: string;
}
const { path } = Astro.props;
---
<div id="waline" class="mt-16"></div>

<script define:vars={{ serverURL: SITE.walineServerURL, path }}>
  if (serverURL && !serverURL.includes('example')) {
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = 'https://unpkg.com/@waline/client@3/dist/waline.css';
    document.head.appendChild(link);

    const s = document.createElement('script');
    s.src = 'https://unpkg.com/@waline/client@3/dist/waline.umd.js';
    s.onload = () => {
      window.Waline.init({
        el: '#waline',
        serverURL,
        path,
        lang: 'zh-CN',
        dark: 'html.dark',
        pageview: true,
      });
    };
    document.body.appendChild(s);
  }
</script>
