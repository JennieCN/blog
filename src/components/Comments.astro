---
import { SITE } from '../config';

interface Props {
  path: string;
}
const { path } = Astro.props;
---
<div id="waline" class="mt-16"></div>

<script define:vars={{ serverURL: SITE.walineServerURL, path }}>
  if (serverURL && !serverURL.includes('example')) {
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = 'https://unpkg.com/@waline/client@3/dist/waline.css';
    document.head.appendChild(link);

    const s = document.createElement('script');
    s.type = 'module';
    s.textContent = `
      import { init } from 'https://unpkg.com/@waline/client@3/dist/waline.mjs';
      init({
        el: '#waline',
        serverURL: ${JSON.stringify(serverURL)},
        path: ${JSON.stringify(path)},
        lang: 'zh-CN',
        dark: 'auto',
      });
    `;
    document.head.appendChild(s);
  }
</script>
