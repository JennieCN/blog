---
import PostMeta from './PostMeta.astro';
import { getSection } from '../config';
import type { PostSummary } from '../lib/posts';

interface Props {
  posts: PostSummary[];
  sectionKey?: string;
  sectionName?: string;
}

const { posts, sectionKey = '', sectionName = '' } = Astro.props;
const forumTargetUrl = sectionKey
  ? `https://qa.mycampusmail.com/t/${sectionKey}`
  : 'https://qa.mycampusmail.com/';
---

<div class="hybrid-stream" data-section={sectionKey}>
  <!-- 双流控制栏：Tab 切换 + 快捷发布按钮 -->
  <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border p-3" style="border-color: var(--color-border); background: var(--color-surface)">
    <div class="flex flex-wrap items-center gap-2 text-sm">
      <button type="button" data-filter="all" class="stream-tab cursor-pointer rounded-lg px-3.5 py-1.5 font-semibold text-white" style="background: var(--color-accent)">
        🔥 全部动态
      </button>
      <button type="button" data-filter="post" class="stream-tab cursor-pointer rounded-lg border px-3.5 py-1.5 font-medium" style="border-color: var(--color-border); background: var(--color-bg)">
        📖 专栏长文 ({posts.length})
      </button>
      <button type="button" data-filter="forum" class="stream-tab cursor-pointer rounded-lg border px-3.5 py-1.5 font-medium" style="border-color: var(--color-border); background: var(--color-bg)">
        💬 社区讨论 <span class="forum-count-badge">…</span>
      </button>
    </div>

    <div class="flex flex-wrap items-center gap-2 text-xs sm:text-sm">
      <a href={forumTargetUrl} class="rounded-lg px-3.5 py-1.5 font-medium text-white" style="background: var(--color-accent)">
        + 发帖 / 提问{sectionName ? `（${sectionName}）` : ''}
      </a>
      <a href="/yjcnb/" class="admin-link hidden rounded-lg border px-3 py-1.5 font-medium" style="border-color: var(--color-border)">
        ✍️ 写专栏长文
      </a>
    </div>
  </div>

  <!-- 实时混排列表 -->
  <ul class="stream-list mt-6 flex flex-col gap-4">
    {posts.map((p) => {
      const sec = getSection(p.section);
      return (
        <li
          class="card stream-item p-5"
          data-kind="post"
          data-ts={p.pubDate.getTime()}
        >
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="rounded px-2 py-0.5 font-semibold" style="background: var(--color-accent-soft); color: var(--color-accent)">
              📖 专栏长文
            </span>
            {sec && (
              <a href={`/${sec.key}/`} class="rounded border px-2 py-0.5" style="border-color: var(--color-border); color: var(--color-muted)">
                {sec.name}
              </a>
            )}
          </div>
          <a href={`/${p.section}/${p.slug}/`} class="mt-2 block text-xl font-bold hover:underline">
            {p.title}
          </a>
          <p class="mt-1.5 text-sm" style="color: var(--color-muted)">{p.description}</p>
          <PostMeta pubDate={p.pubDate} tags={p.tags} pageviewPath={`/${p.section}/${p.slug}/`} />
        </li>
      );
    })}
  </ul>
</div>

<script>
  document.querySelectorAll('.hybrid-stream').forEach((container) => {
    const section = (container as HTMLElement).dataset.section || '';
    const list = container.querySelector('.stream-list') as HTMLElement | null;
    const countBadge = container.querySelector('.forum-count-badge');
    const tabs = Array.from(container.querySelectorAll('.stream-tab')) as HTMLButtonElement[];
    let currentFilter = 'all';

    function applyFilter(filter: string) {
      currentFilter = filter;
      tabs.forEach((btn) => {
        const active = btn.dataset.filter === filter;
        if (active) {
          btn.style.background = 'var(--color-accent)';
          btn.style.color = '#ffffff';
          btn.style.borderColor = 'transparent';
        } else {
          btn.style.background = 'var(--color-bg)';
          btn.style.color = 'var(--color-fg)';
          btn.style.borderColor = 'var(--color-border)';
        }
      });

      if (!list) return;
      Array.from(list.children).forEach((li) => {
        const kind = (li as HTMLElement).dataset.kind;
        (li as HTMLElement).style.display =
          filter === 'all' || kind === filter ? '' : 'none';
      });
    }

    tabs.forEach((btn) => {
      btn.addEventListener('click', () => applyFilter(btn.dataset.filter || 'all'));
    });

    const api = section
      ? `https://qa.mycampusmail.com/feed.php?tag=${encodeURIComponent(section)}&limit=15`
      : 'https://qa.mycampusmail.com/feed.php?limit=15';

    fetch(api)
      .then((r) => r.json())
      .then((data) => {
        const items = data?.items || [];
        if (countBadge) countBadge.textContent = `(${items.length})`;
        if (!list) return;

        items.forEach((d: any) => {
          const li = document.createElement('li');
          li.className = 'card stream-item p-5';
          li.dataset.kind = 'forum';
          li.dataset.ts = String(Date.parse(d.lastPostedAt || d.createdAt || '') || Date.now());

          const tagsHtml = (d.tags || [])
            .map(
              (t: any) =>
                `<a href="/${t.slug}/" class="rounded border px-2 py-0.5" style="border-color: var(--color-border); color: var(--color-muted)">${t.name}</a>`,
            )
            .join('');

          const solvedHtml = d.isSolved
            ? `<span class="rounded px-2 py-0.5 font-semibold" style="background:#dcfce7;color:#166534">✓ 已解决</span>`
            : `<span class="rounded px-2 py-0.5" style="background:#fef3c7;color:#92400e">💬 讨论中</span>`;

          const stickyHtml = d.isSticky
            ? `<span class="rounded px-2 py-0.5 font-semibold" style="background:#fee2e2;color:#991b1b">📌 置顶</span>`
            : '';

          const dateStr = (d.lastPostedAt || d.createdAt || '').slice(0, 10);

          li.innerHTML = `
            <div class="flex flex-wrap items-center gap-2 text-xs">
              <span class="rounded px-2 py-0.5 font-semibold" style="background:#f3e8ff;color:#6b21a8">💬 社区帖子</span>
              ${stickyHtml}
              ${solvedHtml}
              ${tagsHtml}
            </div>
            <a href="${d.url}" class="mt-2 block text-xl font-bold hover:underline">${d.title}</a>
            <p class="mt-1.5 text-sm" style="color: var(--color-muted)">${d.excerpt || ''}</p>
            <div class="mt-3 flex flex-wrap items-center gap-4 text-xs" style="color: var(--color-muted)">
              <span>👤 发帖人：${d.author}</span>
              <span>💬 ${d.commentCount || 1} 条讨论</span>
              <span>🕒 ${dateStr}</span>
              <a href="${d.url}" style="color: var(--color-accent)" class="font-medium">参与盖楼 / 解答 →</a>
            </div>
          `;
          list.appendChild(li);
        });

        applyFilter(currentFilter);
      })
      .catch(() => {
        if (countBadge) countBadge.textContent = '';
      });
  });
</script>
