---
import { svgIcon } from '../lib/icons';
---
<div>
  <div class="search-big" role="search">
    <Fragment set:html={svgIcon('search')} />
    <label class="sr-only" for="search">全站关键词搜索</label>
    <input id="search" type="search" placeholder="输入关键词搜索文章正文与标题…" autocomplete="off" />
  </div>
  <ul id="results" class="stream-list"></ul>
</div>

<script>
  function esc(s: unknown): string {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function safeUrl(u: unknown): string {
    const s = String(u ?? '').trim();
    if (/^https?:\/\//i.test(s) || s.startsWith('/')) return esc(s);
    return '#';
  }

  const input = document.getElementById('search') as HTMLInputElement | null;
  const results = document.getElementById('results');

  async function run() {
    if (!input || !results) return;
    const q = input.value.trim();
    results.innerHTML = '';
    if (!q) return;

    // 运行时拼接路径，避免打包器尝试解析构建后才生成的 Pagefind 文件
    const pagefindPath = ['', 'pagefind', 'pagefind.js'].join('/');
    try {
      const pagefind = await import(/* @vite-ignore */ pagefindPath);
      await pagefind.init();
      const search = await pagefind.search(q);

      for (const r of search.results.slice(0, 15)) {
        const data = await r.data();
        const li = document.createElement('li');
        li.className = 'stream-item';
        li.dataset.kind = 'article';
        const url = safeUrl(data.url);
        const title = esc(data.meta?.title || data.url || '未命名页面');
        li.innerHTML = `
          <div class="item-body">
            <h3 class="item-title"><a href="${url}">${title}</a></h3>
            <p class="item-excerpt">${data.excerpt || ''}</p>
          </div>
        `;
        results.appendChild(li);
      }

      if (search.results.length === 0) {
        results.innerHTML = `
          <li class="empty">
            <div class="empty-art" aria-hidden="true"></div>
            <h2>没有找到相关内容</h2>
            <p>试试更短的关键词，或去问答社区看看。</p>
          </li>`;
      }
    } catch {
      results.innerHTML = `<li class="card muted text-sm">搜索索引仅在生产构建（npm run build）后可用。</li>`;
    }
  }

  input?.addEventListener('input', run);

  const qParam = new URLSearchParams(location.search).get('q');
  if (input && qParam) {
    input.value = qParam;
    run();
  }
</script>
