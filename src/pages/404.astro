---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="页面不存在">
  <div class="py-20 text-center">
    <p class="text-6xl font-bold" style="color: var(--color-muted)">404</p>
    <h1 class="mt-4 text-2xl font-bold">页面不存在</h1>
    <p class="mt-2" style="color: var(--color-muted)">你访问的页面可能已被移动或删除。</p>
    <a href="/" class="mt-8 inline-block rounded px-5 py-2 text-white" style="background: var(--color-accent)">返回首页</a>
  </div>
</BaseLayout>
