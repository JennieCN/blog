---
import BaseLayout from '../layouts/BaseLayout.astro';

const scripts = [
  {
    name: '系统基础信息与资源巡检',
    desc: '一行命令查看 CPU 核数、内存、Swap、磁盘与负载',
    cmd: 'hostname && nproc && free -m && df -h / && uptime',
  },
  {
    name: '融合怪 VPS 综合测评脚本（ECS）',
    desc: '社区常用的硬件、回程路由、流媒体解锁与测速综合脚本',
    cmd: 'curl -L https://gitlab.com/spiritysdx/za/-/raw/main/ecs.sh -o ecs.sh && chmod +x ecs.sh && bash ecs.sh',
  },
  {
    name: 'Docker 官方一键安装',
    desc: 'Ubuntu / Debian 官方源安装最新 Docker Engine 与 Compose 插件',
    cmd: 'curl -fsSL https://get.docker.com | sudo sh',
  },
  {
    name: '快速创建 2GB Swap 交换文件',
    desc: '适合 1GB/2GB 小内存 VPS 防止 OOM 杀进程',
    cmd: 'sudo fallocate -l 2G /swapfile && sudo chmod 600 /swapfile && sudo mkswap /swapfile && sudo swapon /swapfile',
  },
];

const glossary = [
  { cat: 'VPS 线路', term: 'CN2 GIA (AS4809)', desc: '中国电信最高等级精品国际专线，双向全程 59.43 节点，晚高峰极少拥堵。' },
  { cat: 'VPS 线路', term: 'CUII / AS9929', desc: '中国联通精品 A 网国际线路，对标电信 CN2 GIA，延迟低且晚高峰稳定。' },
  { cat: 'VPS 线路', term: 'CMIN2 (AS58807)', desc: '中国移动新一代精品国际专线，大幅改善移动跨境晚高峰丢包。' },
  { cat: 'VPS 线路', term: '163 骨干网 / 4837', desc: '电信 AS4134 与联通 AS4837 普通民用国际骨干网，性价比高但晚高峰视线路优化而定。' },
  { cat: 'FSAE 赛车', term: 'BMS / IMD / BSPD', desc: '电池管理系统（BMS）、绝缘监测装置（IMD）与制动系统合理性检测器（BSPD），电车安全回路三大核心。' },
  { cat: 'FSAE 赛车', term: 'TSAL (高压指示灯)', desc: 'Tractive System Active Light，用于指示整车动力系统是否带高压电的安全灯。' },
  { cat: 'RoboMaster', term: 'C板 / CAN 总线 / 达妙', desc: 'STM32F407 开发板（C型）通过 CAN 总线以 1Mbps 波特率驱动大疆 M3508/GM6020 或达妙关节电机。' },
  { cat: 'RoboMaster', term: 'PnP 弹道解算与超级电容', desc: '视觉通过相机内参与装甲板四点解算距离姿态（SolvePnP），底盘通过超级电容在裁判系统功率限制下实现瞬时加速。' },
  { cat: 'AI 工程', term: 'RAG / vLLM / KV Cache', desc: '检索增强生成（RAG）结合外部知识库防幻觉；vLLM 利用 PagedAttention 管理 KV Cache 显著提升推理吞吐。' },
];
---
<BaseLayout title="实用工具箱" description="VPS 剩余价值计算器、IP 分流检测、节点延迟测速、FSAE/RM 电池组速算、术语词典与常用脚本库">
  <h1 class="text-3xl font-bold">🛠️ 实用工具箱</h1>
  <p class="mt-2" style="color: var(--color-muted)">对标主流测评站与技术社区，集合 VPS 剩余价值、出口 IP 检测、HTTP 延迟测速、FSAE/RM 电池包速算与术语词典。</p>

  <!-- 第一排：IP 分流检测 + 多节点 HTTP 延迟测速 -->
  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <!-- 工具 A：本机出口 IP 与分流检测 -->
    <section class="card p-6">
      <div class="flex items-center justify-between gap-2">
        <h2 class="text-xl font-bold">🌐 本机出口 IP 与分流检测</h2>
        <button type="button" id="btn-recheck-ip" class="cursor-pointer rounded px-3 py-1 text-xs font-medium text-white" style="background: var(--color-accent)">重新检测</button>
      </div>
      <p class="mt-1 text-sm" style="color: var(--color-muted)">实时对比你访问本站边缘节点与国际 API 的出口 IP、归属地与运营商 ASN。</p>
      <div class="mt-4 flex flex-col gap-3 text-sm">
        <div class="rounded-lg border p-3.5" style="border-color: var(--color-border); background: var(--color-bg)">
          <span class="text-xs font-semibold" style="color: var(--color-accent)">Cloudflare 边缘识别出口（本站直连）</span>
          <p id="ip-cf-box" class="mt-1 font-mono text-sm">正在检测边缘出口…</p>
        </div>
        <div class="rounded-lg border p-3.5" style="border-color: var(--color-border); background: var(--color-bg)">
          <span class="text-xs font-semibold" style="color: var(--color-accent)">国际通用出口 IP 与 ASN 运营商</span>
          <p id="ip-intl-box" class="mt-1 font-mono text-sm">正在检测国际出口…</p>
        </div>
      </div>
    </section>

    <!-- 工具 B：多节点 HTTP 延迟测速 -->
    <section class="card p-6">
      <div class="flex items-center justify-between gap-2">
        <h2 class="text-xl font-bold">⚡ 多节点 HTTP 延迟测速</h2>
        <button type="button" id="btn-run-ping" class="cursor-pointer rounded px-3 py-1 text-xs font-medium text-white" style="background: var(--color-accent)">一键测速</button>
      </div>
      <p class="mt-1 text-sm" style="color: var(--color-muted)">从当前浏览器直接向各常用节点发起 HTTP 握手测速，直观检验代理或直连延迟。</p>
      <ul id="ping-list" class="mt-4 flex flex-col gap-2 text-sm"></ul>
    </section>
  </div>

  <!-- 第二排：VPS 剩余价值计算器 + 锂电池包速算 -->
  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <!-- 工具 1：VPS 剩余价值计算器 -->
    <section class="card p-6">
      <h2 class="text-xl font-bold">💰 VPS 剩余价值计算器</h2>
      <p class="mt-1 text-sm" style="color: var(--color-muted)">根据续费金额、付款周期与到期日实时计算机器剩余价值。</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <label class="text-sm">
          <span>续费价格（元或美元）</span>
          <input id="vps-price" type="number" step="0.01" value="100" class="mt-1 w-full rounded border px-3 py-1.5" style="border-color: var(--color-border); background: var(--color-bg)" />
        </label>
        <label class="text-sm">
          <span>周期天数（年付=365，月付=30）</span>
          <input id="vps-cycle" type="number" value="365" class="mt-1 w-full rounded border px-3 py-1.5" style="border-color: var(--color-border); background: var(--color-bg)" />
        </label>
        <label class="text-sm sm:col-span-2">
          <span>到期日期</span>
          <input id="vps-expire" type="date" class="mt-1 w-full rounded border px-3 py-1.5" style="border-color: var(--color-border); background: var(--color-bg)" />
        </label>
      </div>
      <div id="vps-result" class="mt-4 rounded-lg border p-3.5 text-sm font-medium" style="border-color: var(--color-border); background: var(--color-bg)"></div>
    </section>

    <!-- 工具 2：FSAE / RM 锂电池组参数速算 -->
    <section class="card p-6">
      <h2 class="text-xl font-bold">🔋 FSAE / RM 锂电池包参数速算</h2>
      <p class="mt-1 text-sm" style="color: var(--color-muted)">根据串联数 S、并联数 P 与电芯容量计算标称电压、满电电压与总能量。</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        <label class="text-sm">
          <span>串联数 (S)</span>
          <input id="bat-s" type="number" value="6" min="1" class="mt-1 w-full rounded border px-3 py-1.5" style="border-color: var(--color-border); background: var(--color-bg)" />
        </label>
        <label class="text-sm">
          <span>并联数 (P)</span>
          <input id="bat-p" type="number" value="1" min="1" class="mt-1 w-full rounded border px-3 py-1.5" style="border-color: var(--color-border); background: var(--color-bg)" />
        </label>
        <label class="text-sm">
          <span>单节容量 (Ah)</span>
          <input id="bat-ah" type="number" step="0.1" value="5.0" class="mt-1 w-full rounded border px-3 py-1.5" style="border-color: var(--color-border); background: var(--color-bg)" />
        </label>
      </div>
      <div id="bat-result" class="mt-4 rounded-lg border p-3.5 text-sm font-medium" style="border-color: var(--color-border); background: var(--color-bg)"></div>
    </section>
  </div>

  <!-- 第三排：圈子黑话与技术术语速查词典 -->
  <section class="card mt-8 p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-xl font-bold">📚 圈子黑话与技术术语词典（Glossary）</h2>
        <p class="mt-1 text-sm" style="color: var(--color-muted)">收录 VPS 国际线路、FSAE 方程式电检、RoboMaster 机器人与 AI 常用术语缩写。</p>
      </div>
      <input
        id="glossary-search"
        type="search"
        placeholder="输入术语或关键词过滤（如 CN2 / BMS / CAN）…"
        class="w-full sm:w-72 rounded-lg border px-3 py-1.5 text-sm"
        style="border-color: var(--color-border); background: var(--color-bg)"
      />
    </div>
    <div id="glossary-grid" class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {glossary.map((g) => (
        <div class="glossary-item rounded-lg border p-3.5" style="border-color: var(--color-border); background: var(--color-bg)" data-text={`${g.cat} ${g.term} ${g.desc}`.toLowerCase()}>
          <span class="rounded px-2 py-0.5 text-xs font-semibold" style="background: var(--color-accent-soft); color: var(--color-accent)">{g.cat}</span>
          <h3 class="mt-2 font-bold text-sm">{g.term}</h3>
          <p class="mt-1 text-xs leading-relaxed" style="color: var(--color-muted)">{g.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 常用脚本库 -->
  <h2 class="mt-12 text-2xl font-bold">💻 常用 VPS 脚本速查</h2>
  <div class="mt-5 flex flex-col gap-4">
    {scripts.map((s) => (
      <div class="card p-5">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h3 class="font-semibold">{s.name}</h3>
            <p class="text-xs" style="color: var(--color-muted)">{s.desc}</p>
          </div>
          <button type="button" data-cmd={s.cmd} class="copy-cmd cursor-pointer rounded px-3 py-1 text-xs text-white" style="background: var(--color-accent)">复制命令</button>
        </div>
        <pre class="mt-3 overflow-x-auto rounded bg-zinc-900 p-3 text-xs text-zinc-100"><code>{s.cmd}</code></pre>
      </div>
    ))}
  </div>

  <script>
    // 1. 本机出口 IP 与分流检测
    function checkIp() {
      const cfEl = document.getElementById('ip-cf-box');
      const intlEl = document.getElementById('ip-intl-box');
      if (cfEl) cfEl.textContent = '正在检测边缘出口…';
      if (intlEl) intlEl.textContent = '正在检测国际出口…';

      fetch('/cdn-cgi/trace')
        .then((r) => r.text())
        .then((txt) => {
          const map: Record<string, string> = {};
          txt.split('\n').forEach((line) => {
            const [k, v] = line.split('=');
            if (k && v) map[k.trim()] = v.trim();
          });
          if (cfEl) {
            cfEl.textContent = map.ip
              ? `IP: ${map.ip} · 地区: ${map.loc || '未知'} · 边缘机房: ${map.colo || '未知'} (${map.http || ''})`
              : '本地开发环境（上线后由 Cloudflare 边缘节点返回）';
          }
        })
        .catch(() => {
          if (cfEl) cfEl.textContent = '无法连接边缘 trace 接口';
        });

      fetch('https://ipwho.is/')
        .then((r) => r.json())
        .then((d) => {
          if (intlEl && d && d.ip) {
            const isp = d.connection?.isp || d.connection?.org || '';
            const asn = d.connection?.asn ? `AS${d.connection.asn}` : '';
            intlEl.textContent = `IP: ${d.ip} · ${d.country || ''} ${d.city || ''} · ${asn} ${isp}`;
          }
        })
        .catch(() => {
          if (intlEl) intlEl.textContent = '国际 IP 接口请求受限或超时';
        });
    }
    document.getElementById('btn-recheck-ip')?.addEventListener('click', checkIp);
    checkIp();

    // 2. 多节点 HTTP 延迟测速
    const pingTargets = [
      { name: '融夕的书 · 博客主站 (Cloudflare)', url: 'https://blog.mycampusmail.com/favicon.svg' },
      { name: '融夕的书 · 问答社区 (AWS 新加坡)', url: 'https://qa.mycampusmail.com/feed.php?limit=1' },
      { name: 'Cloudflare 全球边缘 (1.1.1.1)', url: 'https://1.1.1.1/cdn-cgi/trace' },
      { name: 'unpkg 前端 CDN 节点', url: 'https://unpkg.com/@waline/client@3/dist/waline.css' },
      { name: 'GitHub 连通性检测', url: 'https://github.githubassets.com/favicons/favicon.svg' },
    ];

    async function runPing() {
      const ul = document.getElementById('ping-list');
      if (!ul) return;
      ul.innerHTML = pingTargets
        .map(
          (t, i) => `
          <li class="flex items-center justify-between rounded-lg border px-3.5 py-2" style="border-color: var(--color-border); background: var(--color-bg)">
            <span class="font-medium">${t.name}</span>
            <span id="ping-res-${i}" class="rounded px-2 py-0.5 font-mono text-xs" style="color: var(--color-muted)">测速中…</span>
          </li>`,
        )
        .join('');

      await Promise.all(
        pingTargets.map(async (t, i) => {
          const badge = document.getElementById(`ping-res-${i}`);
          const t0 = performance.now();
          try {
            const ctrl = new AbortController();
            const timer = setTimeout(() => ctrl.abort(), 5000);
            await fetch(`${t.url}${t.url.includes('?') ? '&' : '?'} _t=${Date.now()}`, {
              mode: 'no-cors',
              cache: 'no-store',
              signal: ctrl.signal,
            });
            clearTimeout(timer);
            const ms = Math.round(performance.now() - t0);
            if (badge) {
              badge.textContent = `${ms} ms`;
              badge.style.background = ms < 180 ? '#dcfce7' : ms < 400 ? '#fef3c7' : '#fee2e2';
              badge.style.color = ms < 180 ? '#166534' : ms < 400 ? '#92400e' : '#991b1b';
            }
          } catch {
            if (badge) {
              badge.textContent = '超时 / 阻断';
              badge.style.background = '#fee2e2';
              badge.style.color = '#991b1b';
            }
          }
        }),
      );
    }
    document.getElementById('btn-run-ping')?.addEventListener('click', runPing);
    runPing();

    // 3. 术语词典搜索过滤
    document.getElementById('glossary-search')?.addEventListener('input', (e) => {
      const q = ((e.target as HTMLInputElement).value || '').trim().toLowerCase();
      document.querySelectorAll('.glossary-item').forEach((el) => {
        const txt = (el as HTMLElement).dataset.text || '';
        (el as HTMLElement).style.display = !q || txt.includes(q) ? '' : 'none';
      });
    });

    // 4. VPS 剩余价值与电池组计算
    const expEl = document.getElementById('vps-expire') as HTMLInputElement | null;
    if (expEl && !expEl.value) {
      const d = new Date(Date.now() + 180 * 86400000);
      expEl.value = d.toISOString().slice(0, 10);
    }

    function calcVps() {
      const price = parseFloat((document.getElementById('vps-price') as HTMLInputElement).value) || 0;
      const cycle = parseFloat((document.getElementById('vps-cycle') as HTMLInputElement).value) || 365;
      const exp = new Date((document.getElementById('vps-expire') as HTMLInputElement).value).getTime();
      const now = Date.now();
      const days = Math.max(0, Math.ceil((exp - now) / 86400000));
      const remain = ((price / cycle) * days).toFixed(2);
      const out = document.getElementById('vps-result');
      if (out) out.textContent = `剩余天数：${days} 天 · 折算剩余价值：${remain}`;
    }

    function calcBat() {
      const s = parseInt((document.getElementById('bat-s') as HTMLInputElement).value) || 1;
      const p = parseInt((document.getElementById('bat-p') as HTMLInputElement).value) || 1;
      const ah = parseFloat((document.getElementById('bat-ah') as HTMLInputElement).value) || 0;
      const vNom = (s * 3.7).toFixed(1);
      const vMax = (s * 4.2).toFixed(1);
      const cap = (p * ah).toFixed(1);
      const wh = (s * 3.7 * p * ah).toFixed(1);
      const out = document.getElementById('bat-result');
      if (out) out.textContent = `${s}S${p}P · 标称 ${vNom}V（满电 ${vMax}V）· 总容量 ${cap}Ah · 总能量 ${wh}Wh`;
    }

    ['vps-price', 'vps-cycle', 'vps-expire'].forEach((id) => document.getElementById(id)?.addEventListener('input', calcVps));
    ['bat-s', 'bat-p', 'bat-ah'].forEach((id) => document.getElementById(id)?.addEventListener('input', calcBat));
    calcVps();
    calcBat();

    document.querySelectorAll('.copy-cmd').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const cmd = (btn as HTMLElement).dataset.cmd || '';
        await navigator.clipboard.writeText(cmd);
        const old = btn.textContent;
        btn.textContent = '已复制';
        setTimeout(() => { btn.textContent = old; }, 1500);
      });
    });
  </script>
</BaseLayout>
