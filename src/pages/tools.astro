---
import BaseLayout from '../layouts/BaseLayout.astro';
import { svgIcon } from '../lib/icons';

const scripts = [
  {
    name: 'NodeQuality (NQ) 一键综合测评脚本',
    desc: '测试 Geekbench 5、fio 磁盘、IP 纯净度、流媒体解锁与三网回程路由',
    cmd: 'bash <(curl -sL https://run.NodeQuality.com)',
  },
  {
    name: '融合怪 VPS 综合测评脚本（ECS）',
    desc: '社区常用的硬件、回程路由、流媒体解锁与测速综合脚本',
    cmd: 'curl -L https://gitlab.com/spiritysdx/za/-/raw/main/ecs.sh -o ecs.sh && chmod +x ecs.sh && bash ecs.sh',
  },
  {
    name: '系统基础信息与端口监听巡检',
    desc: '一行命令查看 CPU 核数、内存、Swap、磁盘、负载与监听端口',
    cmd: 'hostname && nproc && free -m && df -h / && uptime && ss -lntup',
  },
  {
    name: 'Docker 官方一键安装',
    desc: 'Ubuntu / Debian 官方源安装最新 Docker Engine 与 Compose 插件',
    cmd: 'curl -fsSL https://get.docker.com | sudo sh',
  },
  {
    name: '快速创建 2GB Swap 交换文件',
    desc: '适合 1GB/2GB 小内存 VPS 防止 OOM 杀进程',
    cmd: 'sudo fallocate -l 2G /swapfile && sudo chmod 600 /swapfile && sudo mkswap /swapfile && sudo swapon /swapfile',
  },
];

const glossary = [
  { cat: 'VPS 线路', term: 'CN2 GIA (AS4809)', desc: '中国电信最高等级精品国际专线，双向全程 59.43 节点，晚高峰极少拥堵。' },
  { cat: 'VPS 线路', term: 'CUII / AS9929', desc: '中国联通精品 A 网国际线路，对标电信 CN2 GIA，延迟低且晚高峰稳定。' },
  { cat: 'VPS 线路', term: 'CMIN2 (AS58807)', desc: '中国移动新一代精品国际专线，大幅改善移动跨境晚高峰丢包。' },
  { cat: 'VPS 线路', term: '4837 / 软银 / CMI / IIJ', desc: '高性价比次优直连回程：联通 AS4837、日本 SoftBank/IIJ、移动 CMI，适合日常大流量。' },
  { cat: 'VPS 落地', term: '真家宽 vs 双 ISP 伪家宽', desc: '真家宽接入本土运营商（Hinet/AT&T/HKT）；双 ISP 伪家宽物理托管在机房但宣告了住宅属性 IP 段。' },
  { cat: 'VPS 落地', term: 'NAT 家宽 / 共享端口机', desc: '多人共享公网家宽 IP 并按分配端口入站，百元内年付体验真实住宅出口，需留意邻居风控。' },
  { cat: 'FSAE 赛车', term: 'BMS / IMD / BSPD', desc: '电池管理系统（BMS）、绝缘监测装置（IMD）与制动系统合理性检测器（BSPD），电车安全回路三大核心。' },
  { cat: 'FSAE 赛车', term: 'TSAL (高压指示灯)', desc: 'Tractive System Active Light，用于指示整车动力系统是否带高压电的安全灯。' },
  { cat: 'RoboMaster', term: 'C板 / CAN 总线 / 达妙', desc: 'STM32F407 开发板（C型）通过 CAN 总线以 1Mbps 波特率驱动大疆 M3508/GM6020 或达妙关节电机。' },
  { cat: 'RoboMaster', term: 'PnP 弹道解算与超级电容', desc: '视觉通过相机内参与装甲板四点解算距离姿态（SolvePnP），底盘通过超级电容在裁判系统功率限制下实现瞬时加速。' },
  { cat: 'AI 工程', term: 'RAG / vLLM / KV Cache', desc: '检索增强生成（RAG）结合外部知识库防幻觉；vLLM 利用 PagedAttention 管理 KV Cache 显著提升推理吞吐。' },
];
---
<BaseLayout title="实用工具箱" description="VPS 剩余价值计算器、IP 分流检测、节点延迟测速、FSAE/RM 电池组速算、术语词典与常用脚本库">
  <header class="page-head board-head" style="--c: var(--accent)">
    <span class="board-badge" aria-hidden="true" set:html={svgIcon('wrench')} />
    <div>
      <span class="eyebrow" style="margin-bottom: 6px;">即开即用的工程小工具</span>
      <h1 tabindex="-1">实用工具箱</h1>
      <p class="page-sub">
        集合出口 IP 分流检测、多节点 HTTP 延迟测速、VPS 剩余价值计算器、FSAE/RM 电池包速算、术语词典与常用脚本库。
      </p>
    </div>
  </header>

  <!-- 第一排：IP 分流检测 + 多节点 HTTP 延迟测速 -->
  <div class="grid gap-6 lg:grid-cols-2">
    <!-- 工具 A：本机出口 IP 与分流检测 -->
    <section class="card">
      <div class="flex items-center justify-between gap-2">
        <h2 class="card-title" style="margin-bottom: 0;">🌐 本机出口 IP 与分流检测</h2>
        <button type="button" id="btn-recheck-ip" class="btn btn-primary btn-sm">重新检测</button>
      </div>
      <p class="mt-2 text-sm muted">实时对比当前浏览器访问 Cloudflare 边缘节点与国际 ASN 接口的出口地址与归属运营商。</p>
      <div class="mt-4 flex flex-col gap-3 text-sm">
        <div class="tool-box">
          <span class="text-xs font-semibold" style="color: var(--accent)">Cloudflare 边缘识别出口（1.1.1.1 Anycast）</span>
          <p id="ip-cf-box" class="mt-1 mono text-sm">正在检测边缘出口…</p>
        </div>
        <div class="tool-box">
          <span class="text-xs font-semibold" style="color: var(--accent)">国际通用出口 IP 与 ASN 运营商</span>
          <p id="ip-intl-box" class="mt-1 mono text-sm">正在检测国际出口…</p>
        </div>
      </div>
    </section>

    <!-- 工具 B：多节点 HTTP 延迟测速 -->
    <section class="card">
      <div class="flex items-center justify-between gap-2">
        <h2 class="card-title" style="margin-bottom: 0;">⚡ 多节点 HTTP 延迟测速</h2>
        <button type="button" id="btn-run-ping" class="btn btn-primary btn-sm">一键测速</button>
      </div>
      <p class="mt-2 text-sm muted">从当前浏览器直接向各常用节点发起 HTTP 握手测速，直观检验代理或直连延迟。</p>
      <ul id="ping-list" class="mt-4 flex flex-col gap-2 text-sm"></ul>
    </section>
  </div>

  <!-- 第二排：VPS 剩余价值计算器 + 锂电池包速算 -->
  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <!-- 工具 1：VPS 剩余价值计算器 -->
    <section class="card">
      <h2 class="card-title">💰 VPS 剩余价值计算器</h2>
      <p class="text-sm muted">根据续费金额、付款周期与到期日实时计算机器剩余价值。</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <label class="text-sm flex flex-col gap-1">
          <span>续费价格（元或美元）</span>
          <input id="vps-price" type="number" min="0" step="0.01" value="100" class="tool-input" />
        </label>
        <label class="text-sm flex flex-col gap-1">
          <span>周期天数（年付=365，月付=30）</span>
          <input id="vps-cycle" type="number" min="1" value="365" class="tool-input" />
        </label>
        <label class="text-sm sm:col-span-2 flex flex-col gap-1">
          <span>到期日期</span>
          <input id="vps-expire" type="date" class="tool-input" />
        </label>
      </div>
      <div id="vps-result" class="mt-4 tool-box text-sm font-medium" aria-live="polite"></div>
    </section>

    <!-- 工具 2：FSAE / RM 锂电池组参数速算 -->
    <section class="card">
      <h2 class="card-title">🔋 FSAE / RM 锂电池包参数速算</h2>
      <p class="text-sm muted">根据串联数 S、并联数 P、电芯体系与容量计算标称电压、满电电压与总能量。</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <label class="text-sm flex flex-col gap-1">
          <span>串联数 (S)</span>
          <input id="bat-s" type="number" value="6" min="1" class="tool-input" />
        </label>
        <label class="text-sm flex flex-col gap-1">
          <span>并联数 (P)</span>
          <input id="bat-p" type="number" value="1" min="1" class="tool-input" />
        </label>
        <label class="text-sm flex flex-col gap-1">
          <span>单节容量 (Ah)</span>
          <input id="bat-ah" type="number" min="0" step="0.1" value="5.0" class="tool-input" />
        </label>
        <label class="text-sm flex flex-col gap-1">
          <span>电芯化学体系</span>
          <select id="bat-chem" class="tool-input">
            <option value="3.7,4.2" selected>LiPo / 三元锂 (3.7V / 4.2V)</option>
            <option value="3.6,4.2">动力 18650 / 21700 (3.6V / 4.2V)</option>
            <option value="3.2,3.65">磷酸铁锂 LiFePO4 (3.2V / 3.65V)</option>
          </select>
        </label>
      </div>
      <div id="bat-result" class="mt-4 tool-box text-sm font-medium" aria-live="polite"></div>
    </section>
  </div>

  <!-- 第三排：圈子黑话与技术术语速查词典 -->
  <section class="card mt-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="card-title" style="margin-bottom: 4px;">
          <span>📚 圈子黑话与技术术语词典（Glossary）</span>
          <span id="glossary-count" class="text-xs font-normal muted" aria-live="polite">共 {glossary.length} 条</span>
        </h2>
        <p class="text-sm muted">收录猫猫 VPS 选机分类口径、国际线路、FSAE 方程式电检、RoboMaster 机器人与 AI 常用术语缩写。</p>
      </div>
      <input
        id="glossary-search"
        type="search"
        placeholder="输入术语或关键词过滤（如 CN2 / 双ISP / BMS）…"
        class="tool-input sm:w-72"
      />
    </div>
    <div id="glossary-grid" class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {glossary.map((g) => (
        <div
          class="glossary-item tool-box"
          data-text={`${g.cat} ${g.term} ${g.desc}`.toLowerCase()}
        >
          <span class="tag">{g.cat}</span>
          <h3 class="mt-2 font-bold text-sm">{g.term}</h3>
          <p class="mt-1 text-xs leading-relaxed" style="color: var(--text-2)">{g.desc}</p>
        </div>
      ))}
    </div>
    <p id="glossary-empty" class="mt-4 text-sm muted" hidden>没有匹配的术语条目，请换个关键词或按 Esc 清空搜索框。</p>
  </section>

  <!-- 常用脚本库 -->
  <h2 class="section-heading">
    <span>💻 常用 VPS 脚本速查</span>
  </h2>
  <div class="flex flex-col gap-4">
    {scripts.map((s) => (
      <div class="card">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h3 class="font-bold">{s.name}</h3>
            <p class="text-xs muted">{s.desc}</p>
          </div>
          <button type="button" data-cmd={s.cmd} class="copy-cmd btn btn-primary btn-sm">复制命令</button>
        </div>
        <div class="prose mt-3" style="margin-top: 12px;">
          <pre data-lang="bash"><code>{s.cmd}</code></pre>
        </div>
      </div>
    ))}
  </div>

  <script>
    async function copyText(text: string): Promise<boolean> {
      try {
        if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch {}
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        const ok = document.execCommand('copy');
        ta.remove();
        return ok;
      } catch {
        return false;
      }
    }

    // 1. 本机出口 IP 与分流检测
    function checkIp() {
      const cfEl = document.getElementById('ip-cf-box');
      const intlEl = document.getElementById('ip-intl-box');
      if (cfEl) cfEl.textContent = '正在检测边缘出口…';
      if (intlEl) intlEl.textContent = '正在检测国际出口…';

      fetch('https://1.1.1.1/cdn-cgi/trace', { cache: 'no-store' })
        .then((r) => r.text())
        .then((txt) => {
          const map: Record<string, string> = {};
          txt.split('\n').forEach((line) => {
            const [k, v] = line.split('=');
            if (k && v) map[k.trim()] = v.trim();
          });
          if (cfEl) {
            cfEl.textContent = map.ip
              ? `IP: ${map.ip} · 地区: ${map.loc || '未知'} · 边缘机房: ${map.colo || '未知'} (${map.http || ''})`
              : '未能解析边缘节点返回结果';
          }
        })
        .catch(() => {
          if (cfEl) cfEl.textContent = '无法连接 1.1.1.1 边缘 trace 接口';
        });

      fetch('https://ipwho.is/', { cache: 'no-store' })
        .then((r) => r.json())
        .then((d) => {
          if (intlEl && d && d.ip) {
            const isp = d.connection?.isp || d.connection?.org || '';
            const asn = d.connection?.asn ? `AS${d.connection.asn}` : '';
            intlEl.textContent = `IP: ${d.ip} · ${d.country || ''} ${d.city || ''} · ${asn} ${isp}`;
          }
        })
        .catch(() => {
          if (intlEl) intlEl.textContent = '国际 IP 接口请求受限或超时';
        });
    }
    document.getElementById('btn-recheck-ip')?.addEventListener('click', checkIp);
    checkIp();

    // 2. 多节点 HTTP 延迟测速
    const pingTargets = [
      { name: '融夕的书 · 博客主站 (blog.mycampusmail.com)', url: 'https://blog.mycampusmail.com/rss.xml' },
      { name: '融夕的书 · 问答社区 (qa.mycampusmail.com)', url: 'https://qa.mycampusmail.com/api' },
      { name: 'Cloudflare 全球边缘 (1.1.1.1)', url: 'https://1.1.1.1/cdn-cgi/trace' },
      { name: 'MeowVPS 商家目录 (meowvps.com)', url: 'https://meowvps.com/favicon.ico' },
      { name: 'GitHub 国际静态节点', url: 'https://github.githubassets.com/favicons/favicon.svg' },
    ];

    async function runPing() {
      const ul = document.getElementById('ping-list');
      if (!ul) return;
      ul.innerHTML = pingTargets
        .map(
          (t, i) => `
          <li class="tool-box flex items-center justify-between gap-2">
            <span class="font-medium">${t.name}</span>
            <span id="ping-res-${i}" class="rounded px-2 py-0.5 mono text-xs muted">测速中…</span>
          </li>`,
        )
        .join('');

      await Promise.all(
        pingTargets.map(async (t, i) => {
          const badge = document.getElementById(`ping-res-${i}`);
          const t0 = performance.now();
          try {
            const ctrl = new AbortController();
            const timer = setTimeout(() => ctrl.abort(), 5000);
            await fetch(`${t.url}${t.url.includes('?') ? '&' : '?'}_t=${Date.now()}`, {
              mode: 'no-cors',
              cache: 'no-store',
              signal: ctrl.signal,
            });
            clearTimeout(timer);
            const ms = Math.round(performance.now() - t0);
            if (badge) {
              badge.textContent = `${ms} ms`;
              badge.className = `rounded px-2 py-0.5 mono text-xs font-semibold ${
                ms < 180 ? 'badge-ok' : ms < 400 ? 'badge-warn' : 'badge-danger'
              }`;
            }
          } catch {
            if (badge) {
              badge.textContent = '超时 / 阻断';
              badge.className = 'rounded px-2 py-0.5 mono text-xs font-semibold badge-danger';
            }
          }
        }),
      );
    }
    document.getElementById('btn-run-ping')?.addEventListener('click', runPing);
    runPing();

    // 3. 术语词典搜索过滤
    const glossaryInput = document.getElementById('glossary-search') as HTMLInputElement | null;
    const glossaryCount = document.getElementById('glossary-count');
    function filterGlossary() {
      const q = (glossaryInput?.value || '').trim().toLowerCase();
      let visible = 0;
      const allItems = document.querySelectorAll('.glossary-item');
      allItems.forEach((el) => {
        const txt = (el as HTMLElement).dataset.text || '';
        const show = !q || txt.includes(q);
        (el as HTMLElement).style.display = show ? '' : 'none';
        if (show) visible++;
      });
      const emptyEl = document.getElementById('glossary-empty');
      if (emptyEl) emptyEl.hidden = visible > 0;
      if (glossaryCount) {
        glossaryCount.textContent = q ? `匹配 ${visible} / ${allItems.length} 条` : `共 ${allItems.length} 条`;
      }
    }
    glossaryInput?.addEventListener('input', filterGlossary);
    glossaryInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && glossaryInput.value) {
        glossaryInput.value = '';
        filterGlossary();
      }
    });

    // 4. VPS 剩余价值与电池组计算
    const expEl = document.getElementById('vps-expire') as HTMLInputElement | null;
    if (expEl && !expEl.value) {
      const d = new Date(Date.now() + 180 * 86400000);
      expEl.value = d.toISOString().slice(0, 10);
    }

    function calcVps() {
      const priceRaw = parseFloat((document.getElementById('vps-price') as HTMLInputElement).value);
      const cycleRaw = parseFloat((document.getElementById('vps-cycle') as HTMLInputElement).value);
      const expStr = (document.getElementById('vps-expire') as HTMLInputElement).value;
      const out = document.getElementById('vps-result');
      if (!out) return;

      const price = Number.isFinite(priceRaw) ? Math.max(0, priceRaw) : 0;
      const cycle = Number.isFinite(cycleRaw) && cycleRaw > 0 ? cycleRaw : 0;
      const exp = expStr ? new Date(expStr).getTime() : NaN;

      if (!cycle) {
        out.textContent = '请输入大于 0 的周期天数（年付=365，月付=30）';
        return;
      }
      if (Number.isNaN(exp)) {
        out.textContent = '请选择有效的到期日期';
        return;
      }

      const days = Math.max(0, Math.ceil((exp - Date.now()) / 86400000));
      const daily = (price / cycle).toFixed(2);
      const remain = ((price / cycle) * days).toFixed(2);
      const pct = Math.min(100, Math.round((days / cycle) * 100));
      out.textContent = `剩余天数：${days} 天（${pct}%）· 日均 ${daily} · 折算剩余价值：${remain}`;
    }

    function calcBat() {
      const sRaw = parseInt((document.getElementById('bat-s') as HTMLInputElement).value, 10);
      const pRaw = parseInt((document.getElementById('bat-p') as HTMLInputElement).value, 10);
      const ahRaw = parseFloat((document.getElementById('bat-ah') as HTMLInputElement).value);
      const chemStr = (document.getElementById('bat-chem') as HTMLSelectElement | null)?.value || '3.7,4.2';
      const [nomCell, maxCell] = chemStr.split(',').map((n) => parseFloat(n));
      const vCellNom = Number.isFinite(nomCell) ? nomCell : 3.7;
      const vCellMax = Number.isFinite(maxCell) ? maxCell : 4.2;

      const s = Number.isFinite(sRaw) && sRaw >= 1 ? sRaw : 1;
      const p = Number.isFinite(pRaw) && pRaw >= 1 ? pRaw : 1;
      const ah = Number.isFinite(ahRaw) && ahRaw >= 0 ? ahRaw : 0;

      const vNom = (s * vCellNom).toFixed(1);
      const vMax = (s * vCellMax).toFixed(1);
      const cap = (p * ah).toFixed(1);
      const wh = (s * vCellNom * p * ah).toFixed(1);
      const out = document.getElementById('bat-result');
      if (out) out.textContent = `${s}S${p}P · 标称 ${vNom}V（满电 ${vMax}V）· 总容量 ${cap}Ah · 总能量 ${wh}Wh`;
    }

    ['vps-price', 'vps-cycle', 'vps-expire'].forEach((id) => document.getElementById(id)?.addEventListener('input', calcVps));
    ['bat-s', 'bat-p', 'bat-ah'].forEach((id) => document.getElementById(id)?.addEventListener('input', calcBat));
    document.getElementById('bat-chem')?.addEventListener('change', calcBat);
    calcVps();
    calcBat();

    document.querySelectorAll('.copy-cmd').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const cmd = (btn as HTMLElement).dataset.cmd || '';
        const ok = await copyText(cmd);
        const w = window as any;
        if (ok) {
          const old = btn.textContent;
          btn.textContent = '已复制 ✓';
          if (w.RXFX && typeof w.RXFX.toast === 'function') w.RXFX.toast('命令已复制到剪贴板');
          setTimeout(() => { btn.textContent = old; }, 1500);
        } else if (w.RXFX && typeof w.RXFX.toast === 'function') {
          w.RXFX.toast('无法自动复制，请手动从代码块复制');
        }
      });
    });
  </script>
</BaseLayout>
