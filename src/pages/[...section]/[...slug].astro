---
import PostLayout from '../../layouts/PostLayout.astro';
import Comments from '../../components/Comments.astro';
import { SECTIONS, getSection } from '../../config';
import { getCollection, render } from 'astro:content';
import { filterDrafts } from '../../lib/posts';

export async function getStaticPaths() {
  const paths = [];
  for (const s of SECTIONS) {
    const entries = filterDrafts(await getCollection(s.key)).sort(
      (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
    );
    for (let i = 0; i < entries.length; i++) {
      const e = entries[i];
      const prevEntry = entries[i + 1];
      const nextEntry = entries[i - 1];
      paths.push({
        params: { section: s.key, slug: e.id },
        props: {
          entry: e,
          prev: prevEntry ? { title: prevEntry.data.title, href: `/${s.key}/${prevEntry.id}/` } : undefined,
          next: nextEntry ? { title: nextEntry.data.title, href: `/${s.key}/${nextEntry.id}/` } : undefined,
        },
      });
    }
  }
  return paths;
}

const { entry, prev, next } = Astro.props;
const meta = getSection(entry.collection)!;
const { Content, headings } = await render(entry);
---
<PostLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  tags={entry.data.tags}
  sectionName={meta.name}
  sectionKey={meta.key}
  headings={headings}
  prev={prev}
  next={next}
>
  <Content />
  <Comments slot="comments" path={`/${entry.collection}/${entry.id}/`} />
</PostLayout>
