---
import PostLayout from '../../layouts/PostLayout.astro';
import { SECTIONS, getSection } from '../../config';
import { getCollection, render } from 'astro:content';
import { filterDrafts } from '../../lib/posts';

export async function getStaticPaths() {
  const paths = [];
  for (const s of SECTIONS) {
    const entries = filterDrafts(await getCollection(s.key));
    for (const e of entries) {
      paths.push({ params: { section: s.key, slug: e.id }, props: { entry: e } });
    }
  }
  return paths;
}

const { entry } = Astro.props;
const meta = getSection(entry.collection)!;
const { Content } = await render(entry);
---
<PostLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  tags={entry.data.tags}
  sectionName={meta.name}
>
  <Content />
</PostLayout>
