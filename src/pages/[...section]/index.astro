---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HybridStream from '../../components/HybridStream.astro';
import { SECTIONS, getSection } from '../../config';
import { getCollection } from 'astro:content';
import { sortByDateDesc, filterDrafts, type PostSummary } from '../../lib/posts';

export function getStaticPaths() {
  return SECTIONS.map((s) => ({ params: { section: s.key } }));
}

const { section } = Astro.params;
const meta = getSection(section!);
if (!meta) return Astro.redirect('/404');

const entries = filterDrafts(await getCollection(meta.key));
const posts: PostSummary[] = sortByDateDesc(
  entries.map((e) => ({
    section: meta.key,
    slug: e.id,
    title: e.data.title,
    description: e.data.description,
    pubDate: e.data.pubDate,
    tags: e.data.tags,
  })),
);
---
<BaseLayout title={meta.name} description={meta.description}>
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <span class="text-xs font-semibold uppercase tracking-wider" style="color: var(--color-accent)">专栏与社区同区板块</span>
      <h1 class="mt-1 text-3xl font-bold">{meta.name}</h1>
      <p class="mt-2" style="color: var(--color-muted)">{meta.description}</p>
    </div>
    <a href={`https://qa.mycampusmail.com/t/${meta.key}`} class="rounded-lg px-4 py-2 text-sm font-medium text-white" style="background: var(--color-accent)">
      进入「{meta.name}」论坛讨论区 →
    </a>
  </div>

  <section class="mt-8">
    <HybridStream posts={posts} sectionKey={meta.key} sectionName={meta.name} />
  </section>
</BaseLayout>
