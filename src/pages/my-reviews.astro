---
import BaseLayout from '../layouts/BaseLayout.astro';
import { svgIcon } from '../lib/icons';
---
<BaseLayout title="我的测评" description="自购在用 VPS 套餐的一手 IP 质量体检报告、网络表现与上机调优实录">
  <header class="page-head board-head" style="--c: var(--accent)">
    <span class="board-badge" aria-hidden="true" set:html={svgIcon('server')} />
    <div>
      <span class="eyebrow" style="margin-bottom: 6px;">自购在用机器一手留档</span>
      <h1 tabindex="-1">我的测评</h1>
      <p class="page-sub">
        集中记录自购在用 VPS 套餐的 IP 纯净度报告、流媒体/AI 解锁表现与上机调优踩坑手记。
      </p>
    </div>
  </header>

  <article id="attvps-standard" class="card">
    <div class="flex flex-wrap items-start justify-between gap-2">
      <div>
        <h2 class="card-title" style="margin-bottom: 4px;">🇺🇸 ATTVPS · 美国加州洛杉矶 AT&amp;T 静态家宽 标准版（4C8G / 50G NVMe）</h2>
        <p class="text-sm muted">实测日期：2026-11-18 · 规格：4C8G-50G NVMe / 独享带宽无限流量 · Debian 12 (KVM)</p>
      </div>
      <span class="tag">AS7018 · 四库 0 分极净家宽</span>
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-2 text-sm">
      <div class="tool-box">
        <span class="text-xs font-semibold" style="color: var(--accent)">IP 类型属性（五大库）</span>
        <p class="mt-1">IPinfo / ipregistry / ipapi / IP2Location / AbuseIPDB 使用类型全绿「家宽」（162.225.*.*）</p>
      </div>
      <div class="tool-box">
        <span class="text-xs font-semibold" style="color: var(--accent)">风险评分与解锁表现</span>
        <p class="mt-1">Scamalytics 0 / IP2Location 0 / AbuseIPDB 0 / ipapi 0.00% · ChatGPT / TikTok / Disney+ 全原生 US 解锁</p>
      </div>
    </div>

    <div class="mt-4 flex flex-wrap gap-3">
      <a
        href="https://Report.Check.Place/ip/SISEM2MGE.svg"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary btn-sm"
      >
        打开 Check.Place 报告原图（SISEM2MGE.svg）↗
      </a>
    </div>

    <div class="mt-4" style="max-width: 100%; overflow-x: auto; background: #000; padding: 12px; border-radius: 10px;">
      <img
        src="https://Report.Check.Place/ip/SISEM2MGE.svg"
        alt="ATTVPS 美国加州洛杉矶 AT&T静态家宽 Check.Place IP质量体检报告 (SISEM2MGE)"
        loading="lazy"
        style="display: block; max-width: 100%; height: auto; margin: 0 auto;"
      />
    </div>
  </article>

  <article id="usvps24-att-pro9" class="card mt-6">
    <div class="flex flex-wrap items-start justify-between gap-2">
      <div>
        <h2 class="card-title" style="margin-bottom: 4px;">🇺🇸 干杯Cloud · AT&amp;T 商业宽带 PRO-9线（美西洛杉矶 · Rosemead）</h2>
        <p class="text-sm muted">实测日期：2026-11-18 · 规格：2C2G-20G / 200 Mbps / 不限量* · Debian 12 (KVM)</p>
      </div>
      <span class="tag">AS7018 · 原生美国家宽</span>
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-2 text-sm">
      <div class="tool-box">
        <span class="text-xs font-semibold" style="color: var(--accent)">IP 类型属性（五大库）</span>
        <p class="mt-1">IPinfo / ipregistry / ipapi / IP2Location / AbuseIPDB 使用类型全绿「家宽」（107.197.*.*）</p>
      </div>
      <div class="tool-box">
        <span class="text-xs font-semibold" style="color: var(--accent)">风险评分与解锁表现</span>
        <p class="mt-1">ipapi 0.00% 极低风险 · ChatGPT / TikTok / Disney+ / YouTube / AmazonPV 全原生 US 解锁</p>
      </div>
    </div>

    <ul class="mt-4 text-sm flex flex-col gap-1" style="padding-left: 18px;">
      <li><strong>调优方案</strong>：科技lion升级 <code>XanMod 6.18-x64v3</code> 开启 BBRv3 + fq，配置 2 GiB Swap 与跨境长连接缓冲优化。</li>
      <li><strong>排坑提醒</strong>：默认 SLAAC 会分配 <code>2600:1700:...</code> IPv6 地址但出站不通，需在 <code>/etc/gai.conf</code> 开启全局 IPv4 优先。</li>
    </ul>

    <div class="mt-4 flex flex-wrap gap-3">
      <a
        href="https://Report.Check.Place/ip/1PBAA6I6S.svg"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary btn-sm"
      >
        打开 Check.Place 报告原图（1PBAA6I6S.svg）↗
      </a>
      <a
        href="https://usvps24.com"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-ghost btn-sm"
      >
        干杯Cloud 官网 ↗
      </a>
    </div>

    <div class="mt-4" style="max-width: 100%; overflow-x: auto; background: #000; padding: 12px; border-radius: 10px;">
      <img
        src="https://Report.Check.Place/ip/1PBAA6I6S.svg"
        alt="干杯Cloud AT&T商业宽带PRO-9线 Check.Place IP质量体检报告 (1PBAA6I6S)"
        loading="lazy"
        style="display: block; max-width: 100%; height: auto; margin: 0 auto;"
      />
    </div>
  </article>
</BaseLayout>
