---
import BaseLayout from '../layouts/BaseLayout.astro';
import { svgIcon } from '../lib/icons';
import reviewsHtml from '../../scripts/halo-pages/my-reviews.html?raw';
---
<BaseLayout title="我的测评" description="自购在用 10 台主力 VPS 套餐一手实测档案：线路机 TcpQuality + NodeQuality 双脚本测速与落地机 IP 纯净度体检">
  <header class="page-head board-head" style="--c: var(--accent)">
    <span class="board-badge" aria-hidden="true" set:html={svgIcon('server')} />
    <div>
      <span class="eyebrow" style="margin-bottom: 6px;">自购在用机器一手留档</span>
      <h1 tabindex="-1">我的测评</h1>
      <p class="page-sub">
        线路机执行 TcpQuality + NodeQuality 双脚本实测，落地机执行 NodeQuality 全维体检（共 10 台）。
      </p>
    </div>
  </header>

  <Fragment set:html={reviewsHtml} />
</BaseLayout>
