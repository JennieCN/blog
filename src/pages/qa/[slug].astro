---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostMeta from '../../components/PostMeta.astro';
import Comments from '../../components/Comments.astro';
import { getCollection, render } from 'astro:content';
import { filterDrafts } from '../../lib/posts';
import { svgIcon } from '../../lib/icons';

export async function getStaticPaths() {
  const entries = filterDrafts(await getCollection('qa'));
  return entries.map((e) => ({ params: { slug: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.question} description={entry.data.description}>
  <nav class="crumbs" aria-label="位置">
    <a href="/">首页</a>
    <span aria-hidden="true">/</span>
    <a href="/qa/">社区大厅</a>
  </nav>

  <article class="thread">
    <header class="thread-head">
      <div class="item-top">
        <span class="kind-chip kind-question">
          <Fragment set:html={svgIcon('help')} />
          <span>归档问答</span>
        </span>
        {entry.data.solved && (
          <span class="status is-solved">
            <Fragment set:html={svgIcon('check')} />
            <span>已解决</span>
          </span>
        )}
      </div>
      <h1 class="thread-title" tabindex="-1">{entry.data.question}</h1>
      <PostMeta pubDate={entry.data.pubDate} tags={entry.data.tags} />
    </header>
    <div class="prose"><Content /></div>
  </article>

  <section class="comments" aria-labelledby="qa-cm-h">
    <h2 id="qa-cm-h">回答与讨论</h2>
    <Comments path={`/qa/${entry.id}/`} />
  </section>
</BaseLayout>
