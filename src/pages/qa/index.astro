---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostMeta from '../../components/PostMeta.astro';
import { SECTIONS } from '../../config';
import { getCollection } from 'astro:content';
import { filterDrafts, sortByDateDesc } from '../../lib/posts';

const entries = filterDrafts(await getCollection('qa'));
const questions = sortByDateDesc(
  entries.map((e) => ({
    section: 'qa' as const,
    slug: e.id,
    title: e.data.question,
    description: e.data.description,
    pubDate: e.data.pubDate,
    tags: e.data.tags,
    solved: e.data.solved,
  })),
);
---
<BaseLayout title="社区大厅" description="融夕的书 · 问答与交流论坛实时大厅">
  <div class="card p-6 sm:p-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--color-accent)">论坛 × 知识库实时互通</p>
        <h1 class="mt-1 text-3xl font-bold">社区问答与交流大厅</h1>
        <p class="mt-2 text-sm sm:text-base" style="color: var(--color-muted)">
          实时同步问答论坛全部板块讨论帖。支持 GitHub 一键登录、每日签到领书币、最佳答案采纳与图片附件上传。
        </p>
      </div>
      <div class="flex flex-wrap gap-2.5 text-sm">
        <a href="https://qa.mycampusmail.com/" class="rounded-lg px-4 py-2 font-medium text-white" style="background: var(--color-accent)">+ 发帖提问 / 完整论坛视图 →</a>
      </div>
    </div>

    <!-- 按五大板块过滤实时帖子 -->
    <div class="mt-6 flex flex-wrap gap-2 text-xs sm:text-sm" id="qa-tag-filters">
      <button type="button" data-tag="" class="qa-tag-btn cursor-pointer rounded-lg px-3 py-1.5 font-semibold text-white" style="background: var(--color-accent)">
        全部板块
      </button>
      {SECTIONS.map((s) => (
        <button type="button" data-tag={s.key} class="qa-tag-btn cursor-pointer rounded-lg border px-3 py-1.5 font-medium" style="border-color: var(--color-border); background: var(--color-bg)">
          {s.name}
        </button>
      ))}
    </div>
  </div>

  <!-- 实时论坛帖子列表 -->
  <section class="mt-8">
    <h2 class="text-xl font-bold">💬 社区实时讨论帖</h2>
    <ul id="qa-live-list" class="mt-4 flex flex-col gap-4">
      <li class="card p-5 text-sm" style="color: var(--color-muted)">正在同步社区最新帖子…</li>
    </ul>
  </section>

  <!-- 精选归档问答 -->
  {questions.length > 0 && (
    <section class="mt-12">
      <h2 class="text-xl font-bold">📌 站内归档精选问答</h2>
      <ul class="mt-4 flex flex-col gap-4">
        {questions.map((q) => (
          <li class="card p-5">
            <div class="flex items-center gap-2">
              {q.solved && <span class="rounded bg-green-100 px-2 py-0.5 text-xs text-green-800">✓ 已解决</span>}
              <a href={`/qa/${q.slug}/`} class="text-lg font-bold hover:underline">{q.title}</a>
            </div>
            <p class="mt-1 text-sm" style="color: var(--color-muted)">{q.description}</p>
            <PostMeta pubDate={q.pubDate} tags={q.tags} />
          </li>
        ))}
      </ul>
    </section>
  )}

  <script>
    const listEl = document.getElementById('qa-live-list');
    const btns = Array.from(document.querySelectorAll('.qa-tag-btn')) as HTMLButtonElement[];

    function loadFeed(tag: string) {
      btns.forEach((b) => {
        const active = (b.dataset.tag || '') === tag;
        b.style.background = active ? 'var(--color-accent)' : 'var(--color-bg)';
        b.style.color = active ? '#ffffff' : 'var(--color-fg)';
        b.style.borderColor = active ? 'transparent' : 'var(--color-border)';
      });

      const url = tag
        ? `https://qa.mycampusmail.com/feed.php?tag=${encodeURIComponent(tag)}&limit=25`
        : 'https://qa.mycampusmail.com/feed.php?limit=25';

      fetch(url)
        .then((r) => r.json())
        .then((d) => {
          const items = d?.items || [];
          if (!listEl) return;
          if (!items.length) {
            listEl.innerHTML = `<li class="card p-5 text-sm" style="color: var(--color-muted)">该板块暂时还没有帖子，<a href="https://qa.mycampusmail.com/t/${tag}" style="color: var(--color-accent)">点击抢先发第一帖 →</a></li>`;
            return;
          }
          listEl.innerHTML = items
            .map((item: any) => {
              const tags = (item.tags || [])
                .map(
                  (t: any) =>
                    `<span class="rounded border px-2 py-0.5 text-xs" style="border-color: var(--color-border); color: var(--color-muted)">${t.name}</span>`,
                )
                .join('');
              const badge = item.isSolved
                ? `<span class="rounded px-2 py-0.5 text-xs font-semibold" style="background:#dcfce7;color:#166534">✓ 已解决</span>`
                : `<span class="rounded px-2 py-0.5 text-xs" style="background:#fef3c7;color:#92400e">待解答 / 讨论中</span>`;
              const sticky = item.isSticky
                ? `<span class="rounded px-2 py-0.5 text-xs font-semibold" style="background:#fee2e2;color:#991b1b">📌 置顶</span>`
                : '';
              const dateStr = (item.lastPostedAt || item.createdAt || '').slice(0, 10);
              return `
                <li class="card p-5">
                  <div class="flex flex-wrap items-center gap-2">
                    ${sticky}
                    ${badge}
                    ${tags}
                  </div>
                  <a href="${item.url}" class="mt-2 block text-lg font-bold hover:underline">${item.title}</a>
                  <p class="mt-1 text-sm" style="color: var(--color-muted)">${item.excerpt || ''}</p>
                  <div class="mt-3 flex flex-wrap items-center gap-4 text-xs" style="color: var(--color-muted)">
                    <span>👤 ${item.author}</span>
                    <span>💬 ${item.commentCount || 1} 条讨论</span>
                    <span>🕒 ${dateStr}</span>
                    <a href="${item.url}" style="color: var(--color-accent)" class="font-medium">查看并回复 →</a>
                  </div>
                </li>
              `;
            })
            .join('');
        })
        .catch(() => {});
    }

    btns.forEach((b) => {
      b.addEventListener('click', () => loadFeed(b.dataset.tag || ''));
    });

    loadFeed('');
  </script>
</BaseLayout>
