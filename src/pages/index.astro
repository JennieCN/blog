---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import SectionCard from '../components/SectionCard.astro';
import { SECTIONS, SITE } from '../config';
import { getCollection } from 'astro:content';
import { sortByDateDesc, filterDrafts, type PostSummary } from '../lib/posts';

const all: PostSummary[] = [];
const counts: Record<string, number> = {};

for (const s of SECTIONS) {
  const entries = filterDrafts(await getCollection(s.key));
  counts[s.key] = entries.length;
  for (const e of entries) {
    all.push({
      section: s.key,
      slug: e.id,
      title: e.data.title,
      description: e.data.description,
      pubDate: e.data.pubDate,
      tags: e.data.tags,
    });
  }
}

const latest = sortByDateDesc(all).slice(0, 10);
---
<BaseLayout title={SITE.title}>
  <h1 class="text-3xl font-bold">最新文章</h1>
  <section class="mt-8">
    <PostList posts={latest} emptyText="还没有发布任何文章。" />
  </section>
  <h2 class="mt-16 text-2xl font-bold">栏目</h2>
  <section class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {SECTIONS.map((s) => <SectionCard section={s} count={counts[s.key]} />)}
  </section>
</BaseLayout>
