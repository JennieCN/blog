---
import BaseLayout from '../layouts/BaseLayout.astro';
import HybridStream from '../components/HybridStream.astro';
import SectionCard from '../components/SectionCard.astro';
import { SECTIONS, SITE } from '../config';
import { getCollection } from 'astro:content';
import {
  sortByDateDesc,
  filterDrafts,
  wordCount,
  readingMinutes,
  formatDate,
  type PostSummary,
} from '../lib/posts';
import { collectTags } from '../lib/tags';
import { svgIcon } from '../lib/icons';

const all: PostSummary[] = [];
const counts: Record<string, number> = {};
let totalWords = 0;

for (const s of SECTIONS) {
  const entries = filterDrafts(await getCollection(s.key));
  counts[s.key] = entries.length;
  for (const e of entries) {
    const raw = e.body ?? '';
    const words = wordCount(raw);
    totalWords += words;
    all.push({
      section: s.key,
      slug: e.id,
      title: e.data.title,
      description: e.data.description,
      pubDate: e.data.pubDate,
      tags: e.data.tags,
      words,
      minutes: readingMinutes(raw),
    });
  }
}

const sortedAll = sortByDateDesc(all);
const latest = sortedAll.slice(0, 12);
const topTags = [...collectTags(all).entries()]
  .sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0], 'zh'))
  .slice(0, 14);
---
<BaseLayout title={SITE.title}>
  <!-- Hero 横幅 -->
  <section class="page-head hall-head">
    <div>
      <span class="eyebrow">博客专栏 × 问答论坛 · 双流集合体</span>
      <h1>{SITE.title}</h1>
      <p class="page-sub">
        围绕 VPS 与网络基建、大学生方程式赛车（FSAE）、RoboMaster 机器人、AI 工程实践与精选资源打造的「专栏长文 + 互动论坛」集合体。长文沉淀系统知识，论坛实时发帖盖楼与互助解答。
      </p>
      <div id="hero-live-stats" class="page-stats flex flex-wrap items-center gap-x-4 gap-y-1">
        <span>📖 专栏文章 <strong>{all.length}</strong> 篇 · 累计 <strong>{totalWords.toLocaleString()}</strong> 字</span>
        <span id="stat-forum-disc">💬 社区话题加载中…</span>
      </div>
      <div class="hall-actions">
        <a href={`${SITE.forumUrl}/`} class="btn btn-primary" target="_blank" rel="noopener">
          <Fragment set:html={svgIcon('plus')} />
          <span>发起提问 / 盖楼讨论</span>
        </a>
        <a href="/blog/" class="btn">
          <Fragment set:html={svgIcon('book')} />
          <span>全部专栏归档</span>
        </a>
        <a href="/qa/" class="btn">
          <Fragment set:html={svgIcon('chat')} />
          <span>社区大厅</span>
        </a>
        <a href="/tools/" class="btn">
          <Fragment set:html={svgIcon('wrench')} />
          <span>实用工具箱</span>
        </a>
        <a href="/search/" class="btn">
          <Fragment set:html={svgIcon('search')} />
          <span>搜索全站</span>
        </a>
      </div>
    </div>
  </section>

  <h2 class="section-heading">
    <span>五大核心板块（专栏 + 论坛同区互通）</span>
    <a href="/blog/" class="card-more" style="margin-top: 0; font-size: 13px;">按月归档列表 →</a>
  </h2>
  <section class="section-grid">
    {SECTIONS.map((s) => <SectionCard section={s} count={counts[s.key]} />)}
  </section>

  <h2 class="section-heading">
    <span>全站实时动态（长文与社区帖子）</span>
  </h2>
  <section>
    <HybridStream posts={latest} />
  </section>

  <Fragment slot="aside">
    <section class="card author-card" aria-labelledby="home-author-h">
      <div class="author-row">
        <span class="avatar avatar-md" style="--h: 22" aria-hidden="true">{SITE.author.charAt(0)}</span>
        <div>
          <h2 id="home-author-h" class="card-title">{SITE.author}</h2>
          <p class="text-xs muted">{SITE.title}</p>
        </div>
      </div>
      <p class="text-sm" style="color: var(--text-2); line-height: 1.65;">{SITE.authorBio}</p>
      <a class="card-more" href="/about/">了解站点架构 →</a>
    </section>

    <section class="card checkin-card" aria-labelledby="home-stats-h">
      <h2 id="home-stats-h" class="card-title">
        <Fragment set:html={svgIcon('chat')} />
        <span>社区与站内统计</span>
      </h2>
      <dl class="stats">
        <div>
          <dt>专栏</dt>
          <dd>{all.length}</dd>
        </div>
        <div>
          <dt>话题</dt>
          <dd id="aside-forum-count">-</dd>
        </div>
        <div>
          <dt>书币</dt>
          <dd id="aside-user-coins">-</dd>
        </div>
      </dl>
      <p class="hint" id="aside-user-streak">前往 qa.mycampusmail.com 登录（支持 GitHub 一键登录）同步书币与签到</p>
      <a class="card-more" href={`${SITE.forumUrl}/`} target="_blank" rel="noopener">前往问答社区 →</a>
    </section>

    <section class="card" aria-labelledby="home-latest-h">
      <h2 id="home-latest-h" class="card-title">
        <Fragment set:html={svgIcon('book')} />
        <span>最新长文</span>
      </h2>
      <ol class="mini-list">
        {sortedAll.slice(0, 4).map((p) => (
          <li>
            <a href={`/${p.section}/${p.slug}/`}>{p.title}</a>
            <span class="mini-meta">{formatDate(p.pubDate)} · {p.words} 字</span>
          </li>
        ))}
      </ol>
      <a class="card-more" href="/blog/">查看全部专栏 →</a>
    </section>

    {topTags.length > 0 && (
      <section class="card" aria-labelledby="home-tags-h">
        <h2 id="home-tags-h" class="card-title">
          <Fragment set:html={svgIcon('hash')} />
          <span>热门标签</span>
        </h2>
        <div class="tag-cloud">
          {topTags.map(([tag, items]) => (
            <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
              #{tag} {items.length > 1 && <small>{items.length}</small>}
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="card card-quiet" aria-labelledby="home-tools-h">
      <h2 id="home-tools-h" class="card-title">
        <Fragment set:html={svgIcon('wrench')} />
        <span>常用工具速达</span>
      </h2>
      <p class="text-sm" style="color: var(--text-2); line-height: 1.6;">
        出口 IP 分流检测、多节点延迟测速、VPS 剩余价值计算与 FSAE/RM 电池组速算。
      </p>
      <a class="card-more" href="/tools/">打开实用工具箱 →</a>
    </section>
  </Fragment>

  <script>
    fetch('https://qa.mycampusmail.com/feed.php?limit=1')
      .then((r) => r.json())
      .then((d) => {
        const el = document.getElementById('stat-forum-disc');
        const asideCount = document.getElementById('aside-forum-count');
        if (d?.stats) {
          if (asideCount) asideCount.textContent = String(d.stats.discussions ?? '-');
          if (el) {
            el.textContent = '';
            const items: [string, unknown][] = [
              ['💬 社区话题 ', d.stats.discussions ?? 0],
              [' 个 · 讨论 ', d.stats.posts ?? 0],
              [' 条 · 成员 ', d.stats.users ?? 0],
            ];
            items.forEach(([prefix, val]) => {
              el.append(document.createTextNode(prefix));
              const strong = document.createElement('strong');
              strong.textContent = String(val);
              el.append(strong);
            });
            el.append(document.createTextNode(' 人'));
          }
        }
      })
      .catch(() => {});
  </script>
</BaseLayout>
