---
import BaseLayout from '../layouts/BaseLayout.astro';
import { svgIcon } from '../lib/icons';

const milestones = [
  {
    date: '2026-11-17',
    title: '全站视觉与交互升级：三套可切换皮肤与三栏阅读骨架',
    detail: '上线撞色（默认）、水墨、素色三套主题皮肤与深浅色圆形视效切换；引入左侧导航栏 + 右侧辅助信息栏三栏骨架、⌘K 命令面板、专栏按月归档与文章目录滚动高亮。',
  },
  {
    date: '2026-11-10',
    title: '升级为「博客专栏 × 问答论坛」双流集合体，打通全站登录态与真实发信',
    detail: '首页、五大分区与社区大厅实现专栏长文与论坛帖子实时双流混排与切换；打通跨子域账号状态、书币与博客端直接签到；接入 Resend 真实邮件验证码、评论回复通知与 GitHub 一键登录；工具箱新增出口 IP 分流检测、多节点 HTTP 延迟测速与圈子黑话词典。',
  },
  {
    date: '2026-11-10',
    title: '上线交互工具箱、建站时间轴与阅读体验增强',
    detail: '新增 VPS 剩余价值计算器、FSAE/RM 锂电池组参数速算、常用脚本库；文章页支持右侧目录 TOC、代码一键复制、深浅色切换；社区启用最佳答案采纳与图片上传。',
  },
  {
    date: '2026-11-10',
    title: '问答社区 qa.mycampusmail.com 正式上线',
    detail: '在 AWS 新加坡实例部署 Flarum 论坛，完成简体中文界面、五个对应板块标签、新用户免邮件验证自动激活以及与主站双向导航互通。',
  },
  {
    date: '2026-11-09',
    title: '博客主站 blog.mycampusmail.com 上线',
    detail: '完成域名 NS 迁移至 Cloudflare，基于 Astro 5 + Pagefind + Waline + Sveltia CMS 搭建五大内容板块与隐蔽管理后台 /yjcnb/。',
  },
];
---
<BaseLayout title="建站日志" description="融夕的书建站与功能演进时间轴">
  <header class="page-head board-head" style="--c: var(--accent)">
    <span class="board-badge" aria-hidden="true" set:html={svgIcon('calendar')} />
    <div>
      <span class="eyebrow" style="margin-bottom: 6px;">演进记录</span>
      <h1 tabindex="-1">建站日志</h1>
      <p class="page-sub">记录「融夕的书」每一次架构调整与功能更新。</p>
    </div>
  </header>

  <ol class="g-timeline">
    {milestones.map((m) => (
      <li class="card g-timeline-item">
        <div class="flex flex-wrap items-center gap-2 text-xs mono font-semibold" style="color: var(--accent)">
          <time datetime={m.date}>{m.date}</time>
        </div>
        <h2 class="mt-2 text-lg font-bold">{m.title}</h2>
        <p class="mt-2 text-sm leading-relaxed" style="color: var(--text-2)">{m.detail}</p>
      </li>
    ))}
  </ol>
</BaseLayout>
