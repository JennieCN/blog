---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SECTIONS, SITE } from '../config';
import { svgIcon } from '../lib/icons';
---
<BaseLayout title="关于" description="关于「融夕的书」（blog.mycampusmail.com）与问答社区（qa.mycampusmail.com）：117 家 VPS 商家测评双卷档案、自用节点实测、在线工具箱与五大工程板块说明。">
  <header class="page-head board-head" style="--c: var(--accent)">
    <span class="board-badge" aria-hidden="true" set:html={svgIcon('info')} />
    <div>
      <span class="eyebrow" style="margin-bottom: 6px;">关于本站</span>
      <h1 tabindex="-1">关于「{SITE.title}」</h1>
      <p class="page-sub">
        这里是 {SITE.author} 的长期技术与工程笔记站，聚焦服务器网络基建、大学生方程式赛车（FSAE）、RoboMaster 机器人竞赛、AI 工程实践与实用工具整理。采用「专栏长文沉淀知识 + 问答社区实时互动 + 纯前端工具箱」的三位一体形态。
      </p>
    </div>
  </header>

  <div class="grid gap-4 sm:grid-cols-2">
    <section class="card">
      <h2 class="card-title">
        <Fragment set:html={svgIcon('grid')} />
        <span>核心专题与站点构成</span>
      </h2>
      <ul class="flex flex-col gap-3 text-sm leading-relaxed" style="color: var(--text-2)">
        <li>· <strong>117 家 VPS 实测双卷档案</strong>：<a href="/archives/nodeseek-merchant-reviews-2026h2/" style="color: var(--accent); text-decoration: underline;">上卷（61 家新晋与转正商家）</a> 与 <a href="/archives/meowvps-official-merchants-2026h2/" style="color: var(--accent); text-decoration: underline;">下卷（56 家主力与皇冠标杆）</a>，共收录 456 份可展开 NodeQuality / TQ 原始报告</li>
        <li>· <strong>我的自用节点实测</strong>：<a href="/my-reviews/" style="color: var(--accent); text-decoration: underline;">/my-reviews/</a>（站长自持 BWG DC1、Lisahost 双 ISP、Taphip HK 长期一手实测）</li>
        <li>· <strong>在线实用工具箱</strong>：<a href="/tools/" style="color: var(--accent); text-decoration: underline;">/tools/</a>（出口 IP 分流检测、多节点 HTTP 延迟测速、VPS 剩余价值计算器、FSAE/RM 锂电池包速算）</li>
        <li>· <strong>实时问答社区</strong>：<a href={`${SITE.forumUrl}/`} style="color: var(--accent); text-decoration: underline;">qa.mycampusmail.com</a>（五大板块同步交流、每日签到领书币，提供 <a href="/rss.xml" style="color: var(--accent); text-decoration: underline;">RSS 订阅</a> 与 <a href="/sitemap.xml" style="color: var(--accent); text-decoration: underline;">站点地图</a>）</li>
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">
        <Fragment set:html={svgIcon('book')} />
        <span>五个核心板块</span>
      </h2>
      <ul class="flex flex-col gap-3 text-sm leading-relaxed" style="color: var(--text-2)">
        {SECTIONS.map((s) => (
          <li class="flex items-start gap-2">
            <span class="cat-dot mt-1.5" style={`--c: ${s.color}`} aria-hidden="true"></span>
            <div>
              <a href={`/categories/${s.key}`} class="font-bold" style="color: var(--text); text-decoration: underline;">{s.name}</a>
              <span>：{s.description}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
