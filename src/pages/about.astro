---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SECTIONS, SITE } from '../config';
---
<BaseLayout title="关于" description={`关于 ${SITE.title} 与站点结构说明`}>
  <h1 class="text-3xl font-bold">关于「{SITE.title}」</h1>
  <p class="mt-3 text-base" style="color: var(--color-muted)">
    这里是 {SITE.author} 的长期技术与工程笔记站，聚焦服务器网络基建、大学生方程式赛车（FSAE）、RoboMaster 机器人竞赛、AI 工程实践与实用工具整理。采用「专栏长文沉淀知识 + 论坛实时互动」的双流集合体形态。
  </p>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    <div class="card p-5">
      <h2 class="text-lg font-semibold">站点构成</h2>
      <ul class="mt-3 flex flex-col gap-2 text-sm" style="color: var(--color-muted)">
        <li>· <strong>内容主站</strong>：Astro 5 静态构建 + Pagefind 离线全文检索 + Waline 评论与阅读统计（评论回复支持 Resend 邮件提醒）</li>
        <li>· <strong>问答社区</strong>：<a href="https://qa.mycampusmail.com/" class="underline">qa.mycampusmail.com</a>（邮箱验证码或 GitHub 一键登录、发帖盖楼、图片附件、采纳最佳答案、每日签到领书币；提供 <a href="https://qa.mycampusmail.com/feed.rss" class="underline">RSS 订阅</a> 与 <a href="https://qa.mycampusmail.com/sitemap.xml" class="underline">站点地图</a>）</li>
        <li>· <strong>在线工具箱</strong>：<a href="/tools/" class="underline">/tools/</a>（VPS 剩余价值计算器、出口 IP 分流检测、多节点 HTTP 延迟测速、FSAE/RM 锂电池包速算、术语词典与常用脚本库）</li>
        <li>· <strong>统一账号</strong>：博客与论坛共享同一个登录状态、书币与签到记录，全站管理员一套账号即可同时写专栏与管论坛</li>
      </ul>
    </div>

    <div class="card p-5">
      <h2 class="text-lg font-semibold">五个核心板块</h2>
      <ul class="mt-3 flex flex-col gap-2 text-sm" style="color: var(--color-muted)">
        {SECTIONS.map((s) => (
          <li>· <a href={`/${s.key}/`} class="font-medium underline">{s.name}</a>：{s.description}</li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>
