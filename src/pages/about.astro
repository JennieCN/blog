---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SECTIONS, SITE } from '../config';
import { svgIcon } from '../lib/icons';
---
<BaseLayout title="关于" description={`关于 ${SITE.title} 与站点结构说明`}>
  <header class="page-head board-head" style="--c: var(--accent)">
    <span class="board-badge" aria-hidden="true" set:html={svgIcon('info')} />
    <div>
      <span class="eyebrow" style="margin-bottom: 6px;">关于本站</span>
      <h1 tabindex="-1">关于「{SITE.title}」</h1>
      <p class="page-sub">
        这里是 {SITE.author} 的长期技术与工程笔记站，聚焦服务器网络基建、大学生方程式赛车（FSAE）、RoboMaster 机器人竞赛、AI 工程实践与实用工具整理。采用「专栏长文沉淀知识 + 论坛实时互动」的双流集合体形态。
      </p>
    </div>
  </header>

  <div class="grid gap-4 sm:grid-cols-2">
    <section class="card">
      <h2 class="card-title">
        <Fragment set:html={svgIcon('grid')} />
        <span>站点构成</span>
      </h2>
      <ul class="flex flex-col gap-3 text-sm leading-relaxed" style="color: var(--text-2)">
        <li>· <strong>内容主站</strong>：Astro 5 静态构建 + Pagefind 离线全文检索 + Waline 评论与阅读统计（评论回复支持 Resend 邮件提醒）</li>
        <li>· <strong>问答社区</strong>：<a href={`${SITE.forumUrl}/`} style="color: var(--accent); text-decoration: underline;">qa.mycampusmail.com</a>（邮箱验证码或 GitHub 一键登录、发帖盖楼、图片附件、采纳最佳答案、每日签到领书币；提供 <a href={`${SITE.forumUrl}/feed.rss`} style="color: var(--accent); text-decoration: underline;">RSS 订阅</a> 与 <a href={`${SITE.forumUrl}/sitemap.xml`} style="color: var(--accent); text-decoration: underline;">站点地图</a>）</li>
        <li>· <strong>在线工具箱</strong>：<a href="/tools/" style="color: var(--accent); text-decoration: underline;">/tools/</a>（VPS 剩余价值计算器、出口 IP 分流检测、多节点 HTTP 延迟测速、FSAE/RM 锂电池包速算、术语词典与常用脚本库）</li>
        <li>· <strong>统一账号</strong>：博客与论坛共享同一个登录状态、书币与签到记录，全站管理员一套账号即可同时写专栏与管论坛</li>
      </ul>
    </section>

    <section class="card">
      <h2 class="card-title">
        <Fragment set:html={svgIcon('book')} />
        <span>五个核心板块</span>
      </h2>
      <ul class="flex flex-col gap-3 text-sm leading-relaxed" style="color: var(--text-2)">
        {SECTIONS.map((s) => (
          <li class="flex items-start gap-2">
            <span class="cat-dot mt-1.5" style={`--c: ${s.color}`} aria-hidden="true"></span>
            <div>
              <a href={`/${s.key}/`} class="font-bold" style="color: var(--text); text-decoration: underline;">{s.name}</a>
              <span>：{s.description}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
