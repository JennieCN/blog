---
import BaseLayout from './BaseLayout.astro';
import PostMeta from '../components/PostMeta.astro';

interface NavPost {
  title: string;
  href: string;
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  sectionName: string;
  sectionKey: string;
  headings?: Heading[];
  prev?: NavPost;
  next?: NavPost;
}
const { title, description, pubDate, updatedDate, tags, sectionName, sectionKey, headings = [], prev, next } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<BaseLayout title={title} description={description} type="article" pubDate={pubDate}>
  <div class="grid gap-10 lg:grid-cols-[1fr_15rem]">
    <article class="min-w-0">
      <a href={`/${sectionKey}/`} class="text-sm font-medium" style="color: var(--color-accent)">{sectionName}</a>
      <h1 class="mt-2 text-3xl font-bold leading-tight">{title}</h1>
      <div class="mt-3"><PostMeta pubDate={pubDate} tags={tags} pageviewPath={Astro.url.pathname} /></div>
      {updatedDate && <p class="mt-1 text-sm" style="color: var(--color-muted)">更新于 {updatedDate.toISOString().slice(0, 10)}</p>}
      <div class="prose mt-8"><slot /></div>

      <!-- 社区联动与上下篇导航 -->
      <div class="mt-12 flex flex-wrap items-center justify-between gap-4 rounded-lg border p-4 text-sm" style="border-color: var(--color-border); background: var(--color-surface)">
        <span>对本文有疑问或补充？可以在下方直接留言，或在社区发起带标签的讨论帖。</span>
        <a href={`https://qa.mycampusmail.com/t/${sectionKey}`} target="_blank" rel="noopener" class="rounded px-3.5 py-1.5 text-white" style="background: var(--color-accent)">前往「{sectionName}」社区板块 →</a>
      </div>

      {(prev || next) && (
        <nav class="mt-8 grid gap-4 sm:grid-cols-2">
          {prev ? (
            <a href={prev.href} class="card block p-4">
              <span class="text-xs" style="color: var(--color-muted)">← 上一篇</span>
              <p class="mt-1 font-semibold">{prev.title}</p>
            </a>
          ) : <div />}
          {next && (
            <a href={next.href} class="card block p-4 text-right">
              <span class="text-xs" style="color: var(--color-muted)">下一篇 →</span>
              <p class="mt-1 font-semibold">{next.title}</p>
            </a>
          )}
        </nav>
      )}

      <slot name="comments" />
    </article>

    {tocHeadings.length > 0 && (
      <aside class="hidden lg:block">
        <div class="sticky top-20 rounded-lg border p-4 text-sm" style="border-color: var(--color-border); background: var(--color-surface)">
          <p class="font-semibold">本文目录</p>
          <ul class="mt-3 flex flex-col gap-2" style="color: var(--color-muted)">
            {tocHeadings.map((h) => (
              <li class={h.depth === 3 ? 'pl-3 text-xs' : ''}>
                <a href={`#${h.slug}`} class="hover:underline">{h.text}</a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )}
  </div>

  <script>
    // 为正文所有代码块注入右上角「复制」按钮
    document.querySelectorAll('.prose pre').forEach((pre) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = '复制';
      btn.style.cssText = 'position:absolute;top:8px;right:8px;padding:2px 8px;font-size:12px;border-radius:4px;background:#27272a;color:#e4e4e7;border:1px solid #3f3f46;cursor:pointer';
      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.innerText ?? (pre as HTMLElement).innerText;
        await navigator.clipboard.writeText(code);
        btn.textContent = '已复制';
        setTimeout(() => { btn.textContent = '复制'; }, 1500);
      });
      pre.appendChild(btn);
    });
  </script>
</BaseLayout>
