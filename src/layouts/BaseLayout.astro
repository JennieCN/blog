---
import Nav from '../components/Nav.astro';
import Sidebar from '../components/Sidebar.astro';
import Tabbar from '../components/Tabbar.astro';
import DefaultAside from '../components/DefaultAside.astro';
import { SITE } from '../config';
import { svgIcon } from '../lib/icons';
import globalCssUrl from '../styles/global.css?url';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
}

const { title, description = SITE.description, type = 'website', pubDate } = Astro.props;
const pageTitle = title === SITE.title ? title : `${title} · ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="dns-prefetch" href={SITE.forumUrl} />
    <link rel="preconnect" href={SITE.forumUrl} crossorigin />
    {type === 'article' && SITE.walineServerURL && (
      <link rel="dns-prefetch" href={SITE.walineServerURL} />
    )}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

    <script is:inline>
      // 首屏防闪烁：兼容旧版 theme 键名与新版 rx-theme
      (function () {
        try {
          var saved = localStorage.getItem('rx-theme') || localStorage.getItem('theme');
          var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>

    <link rel="stylesheet" href={globalCssUrl} />
    <link rel="stylesheet" href="/skins/luxe.css" />
    <link rel="stylesheet" href="/skins/pop.css" id="skin-pop" />
    <link rel="stylesheet" href="/skins/ink.css" id="skin-ink" />
    <link rel="stylesheet" href="/skins/plain.css" id="skin-plain" />

    <script is:inline>
      // 首屏防闪烁：默认使用「撞色（pop）」皮肤，支持 pop / ink / plain 切换
      (function () {
        var skins = ['pop', 'ink', 'plain'];
        var skin = 'pop';
        try {
          var s = localStorage.getItem('rx-skin');
          if (s && skins.indexOf(s) > -1) skin = s;
        } catch (e) {}
        document.documentElement.dataset.skin = skin;
        for (var i = 0; i < skins.length; i++) {
          var el = document.getElementById('skin-' + skins[i]);
          if (el) el.disabled = skins[i] !== skin;
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': type === 'article' ? 'BlogPosting' : 'WebSite',
      headline: title,
      description,
      url: canonical,
      ...(pubDate ? { datePublished: pubDate.toISOString() } : {}),
      author: { '@type': 'Person', name: SITE.author },
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <div id="read-progress" aria-hidden="true"></div>

    <Nav />

    <div class="shell">
      <div class="scrim" id="scrim" hidden></div>
      <Sidebar />

      <main id="main" class="main" tabindex="-1">
        <slot />
        <footer class="site-footer">
          <span>© {new Date().getFullYear()} {SITE.author} · {SITE.title}</span>
          <div class="flex flex-wrap gap-4">
            <a href="/blog/">全部专栏</a>
            <a href="/timeline/">建站日志</a>
            <a href="/tools/">实用工具</a>
            <a href="/rss.xml">RSS</a>
            <a href="/about/">关于</a>
          </div>
        </footer>
      </main>

      <aside id="aside" class="aside" aria-label="补充信息">
        <slot name="aside">
          <DefaultAside />
        </slot>
      </aside>
    </div>

    <Tabbar />

    <div class="toast-wrap" aria-live="polite" aria-atomic="true">
      <div id="toast" class="toast" hidden></div>
    </div>

    <dialog id="shortcuts" aria-labelledby="shortcuts-title">
      <div class="dialog-head">
        <h2 id="shortcuts-title">键盘快捷键</h2>
        <button class="icon-btn" type="button" onclick="this.closest('dialog').close()" aria-label="关闭" set:html={svgIcon('x')} />
      </div>
      <dl class="kbd-list">
        <div><dt><kbd>⌘/Ctrl</kbd> + <kbd>K</kbd></dt><dd>打开命令面板</dd></div>
        <div><dt><kbd>/</kbd></dt><dd>快捷搜索</dd></div>
        <div><dt><kbd>Esc</kbd></dt><dd>关闭弹窗或抽屉</dd></div>
        <div><dt><kbd>?</kbd></dt><dd>查看快捷键列表</dd></div>
      </dl>
    </dialog>

    <dialog id="lightbox" class="lightbox" aria-label="图片预览">
      <button class="icon-btn lightbox-close" type="button" onclick="this.closest('dialog').close()" aria-label="关闭预览" set:html={svgIcon('x')} />
      <img id="lightbox-img" src="" alt="" />
      <figcaption id="lightbox-caption" class="lightbox-caption"></figcaption>
    </dialog>

    <script is:inline src="/scripts/fx.js"></script>

    <script>
      // 阅读进度条（rAF 节流）
      const bar = document.getElementById('read-progress');
      let progressRaf = 0;
      function paintProgress() {
        progressRaf = 0;
        if (!bar) return;
        const h = document.documentElement.scrollHeight - window.innerHeight;
        const p = h > 0 ? Math.min(1, Math.max(0, window.scrollY / h)) : 0;
        bar.style.transform = `scaleX(${p})`;
      }
      function queueProgress() {
        if (!progressRaf) progressRaf = requestAnimationFrame(paintProgress);
      }
      window.addEventListener('scroll', queueProgress, { passive: true });
      window.addEventListener('resize', queueProgress, { passive: true });
      paintProgress();

      // 正文图片点击放大
      const lb = document.getElementById('lightbox') as HTMLDialogElement | null;
      const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      const lbCap = document.getElementById('lightbox-caption');
      function openLightbox(img: HTMLImageElement) {
        if (!lb || !lbImg) return;
        lbImg.src = img.currentSrc || img.src;
        lbImg.alt = img.alt || '';
        if (lbCap) {
          lbCap.textContent = img.alt || '';
          lbCap.hidden = !img.alt;
        }
        if (typeof lb.showModal === 'function') lb.showModal();
      }
      document.querySelectorAll('.prose img').forEach((node) => {
        const img = node as HTMLImageElement;
        img.addEventListener('click', () => openLightbox(img));
      });
      lb?.addEventListener('click', (e) => {
        if (e.target === lb) lb.close();
      });
    </script>
  </body>
</html>
